---
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: string;
  heroImageAlt?: string;
  tags?: string[];
  slug: string;
  readingTime?: number;
  featured?: boolean;
}

const { title, description, pubDate, heroImage, heroImageAlt, tags, slug, readingTime, featured } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
---

<article class={`blog-card ${featured ? 'blog-card--featured' : ''}`}>
  <a href={`/blog/${slug}`} class="blog-card-image-link" tabindex="-1" aria-hidden="true">
    {heroImage ? (
      <img
        src={heroImage}
        alt={heroImageAlt ?? title}
        class="blog-card-img"
        loading="lazy"
        decoding="async"
        width="800"
        height="450"
      />
    ) : (
      <div class="blog-card-img-placeholder">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
      </div>
    )}
  </a>

  <div class="blog-card-body">
    {tags && tags.length > 0 && (
      <div class="blog-card-tags">
        {tags.slice(0, 2).map(tag => (
          <span class="blog-card-tag">{tag}</span>
        ))}
      </div>
    )}

    <h2 class="blog-card-title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h2>

    <p class="blog-card-desc">{description}</p>

    <div class="blog-card-footer">
      <time datetime={pubDate.toISOString()} class="blog-card-date">{formattedDate}</time>
      {readingTime && <span class="blog-card-reading">· {readingTime} min read</span>}
      <a href={`/blog/${slug}`} class="blog-card-read-link">
        Read article
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    background: var(--white);
    border: 1px solid var(--gray-mid);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow .25s ease, transform .25s ease;
  }
  .blog-card:hover {
    box-shadow: 0 12px 40px rgba(13,122,149,.12);
    transform: translateY(-4px);
  }
  .blog-card--featured {
    grid-column: 1 / -1;
    flex-direction: row;
  }
  .blog-card--featured .blog-card-image-link {
    width: 45%;
    flex-shrink: 0;
  }
  .blog-card--featured .blog-card-img {
    height: 100%;
    min-height: 280px;
  }
  .blog-card--featured .blog-card-body {
    padding: 40px;
    justify-content: center;
  }
  .blog-card--featured .blog-card-title { font-size: clamp(20px, 2.5vw, 28px); }
  @media (max-width: 700px) {
    .blog-card--featured { flex-direction: column; }
    .blog-card--featured .blog-card-image-link { width: 100%; }
    .blog-card--featured .blog-card-body { padding: 24px; }
  }

  .blog-card-image-link { display: block; }
  .blog-card-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform .35s ease;
  }
  .blog-card:hover .blog-card-img { transform: scale(1.03); }
  .blog-card-img-placeholder {
    width: 100%;
    height: 220px;
    background: var(--gray-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }

  .blog-card-body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .blog-card-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .blog-card-tag {
    background: rgba(26,171,204,.12);
    color: var(--teal);
    border-radius: 50px;
    padding: 3px 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .07em;
  }
  .blog-card-title {
    font-size: clamp(17px, 2vw, 20px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    margin: 0;
  }
  .blog-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color .2s;
  }
  .blog-card-title a:hover { color: var(--teal); }
  .blog-card-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.65;
    flex: 1;
  }
  .blog-card-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .blog-card-date {
    font-size: 13px;
    color: var(--text-muted);
  }
  .blog-card-reading {
    font-size: 13px;
    color: var(--text-muted);
  }
  .blog-card-read-link {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
    transition: color .2s, gap .2s;
  }
  .blog-card-read-link:hover {
    color: var(--teal-light);
    gap: 8px;
  }
</style>
