---
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  grid?: boolean;
}
const { src, alt, caption, grid } = Astro.props;
---

<div class={grid ? 'blog-image-grid' : 'blog-image-block'}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {caption && <p class="blog-image-caption">{caption}</p>}
</div>
