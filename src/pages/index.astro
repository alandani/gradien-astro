    {
      "@type": "WebSite",
      "@id": "https://gradien.co/#website",
      "url": "https://gradien.co",
      "name": "Gradien Digital Indonesia",
      "description": "Your Partner for Smarter Digital Solutions — custom software development powered by AI",
      "publisher": { "@id": "https://gradien.co/#organization" }
    }
  ]
};

const coreServices = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    title: 'Web Development',
    desc: 'We build websites and web applications that do more than look good — from company profiles to complex web platforms, every project is custom-built to fit your business goals and built to perform.',
    tags: ['React', 'Next.js', 'Laravel', 'Vue.js'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title: 'Mobile Development',
    desc: 'Cross-platform mobile apps built for real users. We design and develop iOS and Android apps that are fast, intuitive, and aligned with how your customers actually work.',
    tags: ['Flutter', 'React Native', 'iOS', 'Android'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M22 2L12 12M15 2h7v7"/></svg>`,
    title: 'AI Integration',
    desc: 'We embed AI into your existing systems and workflows — from intelligent document processing to internal assistants and smart analytics — so your software doesn\'t just run your business, it learns from it.',
    tags: ['OpenAI', 'LangChain', 'Python', 'TensorFlow'],
    featured: true,
  },
];

const extendedServices = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2M8 11h8M8 15h5"/></svg>`,
    title: 'ERP (Odoo)',
    desc: 'We implement, customize, and optimize Odoo ERP for businesses that need a system that actually fits their operations — not the other way around.',
    tags: ['Odoo', 'Accounting', 'Inventory', 'CRM'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`,
    title: 'UI/UX Design',
    desc: 'Great software starts with great design. We craft interfaces that are intuitive, on-brand, and built around how your users think and move.',
    tags: ['Figma', 'User Research', 'Prototyping'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'IT Consulting',
    desc: 'Not sure where to start with your digital journey? We help you cut through the noise — evaluating your current systems, identifying the right technology, and building a roadmap that makes sense for your business.',
    tags: ['Strategy', 'Architecture', 'Roadmap'],
  },
];

const portfolioItems = [
  {
    title: 'Land Registry GIS System',
    category: 'GIS · Government',
    desc: 'A spatial data platform for local government enabling real-time land parcel tracking across 40,000+ records.',
    tags: ['QGIS', 'PostGIS', 'React', 'FastAPI'],
    color: '#0D7A95',
  },
  {
    title: 'ERP Odoo for Retail Chain',
    category: 'ERP · Retail',
    desc: 'End-to-end Odoo 17 implementation covering inventory, POS, accounting, and HR for a 12-outlet chain.',
    tags: ['Odoo 17', 'PostgreSQL', 'Python'],
    color: '#1AABCC',
  },
  {
    title: 'Logistics Mobile App',
    category: 'Mobile · Logistics',
    desc: 'Flutter-based driver app with real-time GPS tracking, digital POD, and offline-first architecture.',
    tags: ['Flutter', 'Firebase', 'Google Maps'],
    color: '#074558',
  },
  {
    title: 'AI-Powered Document OCR',
    category: 'AI · Finance',
    desc: 'Intelligent document processing system for a financial institution — 95% extraction accuracy on mixed document types.',
    tags: ['Python', 'OpenAI', 'Tesseract', 'FastAPI'],
    color: '#0D7A95',
  },
  {
    title: 'Hospital Management System',
    category: 'Web · Healthcare',
    desc: 'Integrated HMS with patient records, appointment scheduling, billing, and pharmacy modules.',
    tags: ['Laravel', 'Vue.js', 'MySQL'],
    color: '#1AABCC',
  },
  {
    title: 'Supply Chain Analytics Dashboard',
    category: 'Analytics · Manufacturing',
    desc: 'Real-time BI dashboard connecting ERP, IoT sensors, and warehouse data for production insights.',
    tags: ['Python', 'Power BI', 'REST API'],
    color: '#074558',
  },
];

const techStack = [
  // Mobile
  { name: 'Flutter', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/flutter/flutter-original.svg' },
  { name: 'React Native', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg' },
  { name: 'Kotlin', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/kotlin/kotlin-original.svg' },
  { name: 'Swift', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/swift/swift-original.svg' },
  // Frontend
  { name: 'React', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg' },
  { name: 'Next.js', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nextjs/nextjs-original.svg' },
  { name: 'Vue.js', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vuejs/vuejs-original.svg' },
  { name: 'Astro', logo: 'https://cdn.simpleicons.org/astro/FF5D01' },
  { name: 'TypeScript', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg' },
  // Backend
  { name: 'Laravel', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/laravel/laravel-original.svg' },
  { name: 'Node.js', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg' },
  { name: 'Python', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg' },
  { name: 'FastAPI', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/fastapi/fastapi-original.svg' },
  { name: 'Django', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/django/django-plain.svg' },
  { name: 'Go', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/go/go-original-wordmark.svg' },
  { name: 'Streamlit', logo: 'https://cdn.simpleicons.org/streamlit/FF4B4B' },
  // Database & ERP
  { name: 'PostgreSQL', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg' },
  { name: 'MySQL', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg' },
  { name: 'Odoo', logo: 'https://cdn.simpleicons.org/odoo/714B67' },
  // AI & ML
  { name: 'TensorFlow', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tensorflow/tensorflow-original.svg' },
  { name: 'OpenAI', logo: 'https://api.iconify.design/simple-icons:openai.svg?color=%23333333' },
  { name: 'Claude', logo: 'https://cdn.simpleicons.org/anthropic/191919' },
  { name: 'LangChain', logo: 'https://cdn.simpleicons.org/langchain/1C3C3C' },
  { name: 'OpenClaw', logo: 'https://openclaw.ai/favicon.svg' },
  { name: 'Hugging Face', logo: 'https://cdn.simpleicons.org/huggingface/FFD21E' },
  { name: 'n8n', logo: 'https://cdn.simpleicons.org/n8n/EA4B71' },
  // DevOps & Cloud
  { name: 'Docker', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg' },
  { name: 'AWS', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-plain-wordmark.svg' },
  { name: 'Google Cloud', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/googlecloud/googlecloud-original.svg' },
  { name: 'Linux', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/linux/linux-original.svg' },
  { name: 'GitHub', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg' },
  { name: 'Grafana', logo: 'https://cdn.simpleicons.org/grafana/F46800' },
  { name: 'Prometheus', logo: 'https://cdn.simpleicons.org/prometheus/E6522C' },
  // Data & GIS
  { name: 'Metabase', logo: 'https://cdn.simpleicons.org/metabase/509EE3' },
  { name: 'QGIS', logo: 'https://cdn.simpleicons.org/qgis/589632' },
  { name: 'Leaflet', logo: 'https://cdn.simpleicons.org/leaflet/199900' },
