const testimonials = [
  {
    quote: "Gradien memahami kebutuhan kami dengan baik dan menghadirkan solusi yang tepat. Tim mereka responsif dan selalu siap membantu bahkan setelah proyek selesai.",
    role: "Project Manager, DPD Gerindra Prov. Lampung",
    initials: "G",
  },
  {
    quote: "Implementasi sistem berjalan lancar dan tim Gradien sangat suportif selama proses go-live. Solusi yang mereka bangun benar-benar sesuai dengan alur kerja kami.",
    role: "Operations Director, PT Tunas Dwipa Matra",
    initials: "T",
  },
  {
    quote: "Gradien tidak hanya membangun aplikasi — mereka benar-benar mengerti bisnis kami dan memberikan saran yang membantu kami berkembang secara digital.",
    role: "Director, PT Way Kanan Makmur",
    initials: "W",
  },
];

const processSteps = [
  { number: '01', title: 'Understand', desc: 'We listen, observe, and explore your business needs and current conditions — to give you a solution that actually makes an impact.' },
  { number: '02', title: 'Solution & Concept', desc: 'We formulate the solution and create a detailed blueprint. Your feedback at this stage shapes the exact direction before we build.' },
  { number: '03', title: 'Develop', desc: 'Our experienced team gets to work — with regular progress reports so you always know where things stand. You focus on your business; we handle the build.' },
  { number: '04', title: 'Deliver & Evaluate', desc: 'We deliver with excellence and stay by your side after launch — supporting you to achieve maximum results from your new digital solution.' },
];
---

<BaseLayout
  title="Gradien Digital Indonesia — Your Partner for Smarter Digital Solutions"
  description="CV. Gradien Digital Indonesia membangun custom website, mobile app, dan enterprise system dengan AI sebagai bagian dari proses kami — solusi digital yang lebih cerdas untuk bisnis Indonesia."
  tags={["software house Indonesia","jasa pembuatan aplikasi","web development","ERP Odoo","AI integration Indonesia","mobile app development","custom software","Gradien Digital"]}
  jsonLd={homeJsonLd}
>

<!-- ══════════════════ HERO ══════════════════════════ -->
<section id="hero">
  <div class="hero-dots" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="hero-badge-dot" aria-hidden="true"></span>
          <span>Gerakan Digital Ekosistem Nusantara</span>
        </div>
        <h1 class="hero-title">
          Your Partner for<br/>
          <span class="accent">Smarter Digital</span><br/>
          Solutions
        </h1>
        <p class="hero-sub">
          We build custom websites, mobile apps, and enterprise systems — with AI embedded in our process so every solution works smarter for your business.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">Start a Project</a>
          <a href="#portfolio" class="btn btn-outline">See Our Work</a>
        </div>
        <div class="hero-stats">
          <div>
            <div class="stat-num">50<span class="stat-accent">+</span></div>
            <div class="stat-label">Projects Delivered</div>
          </div>
          <div>
            <div class="stat-num">30<span class="stat-accent">+</span></div>
            <div class="stat-label">Happy Clients</div>
          </div>
          <div>
            <div class="stat-num">5<span class="stat-accent">+</span></div>
            <div class="stat-label">Years Experience</div>
          </div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hero-blob"></div>
        <div class="hero-card-stack">
          <div class="hero-card">
            <div class="hero-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </div>
            <div class="hero-card-title">Web Development</div>
            <div class="hero-card-sub">Company Profile · Web App · Portal</div>
            <span class="hero-card-pill">React · Laravel · Next.js</span>
          </div>
          <div class="hero-card">
            <div class="hero-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </div>
            <div class="hero-card-title">Mobile Development</div>
            <div class="hero-card-sub">iOS · Android · Cross-platform</div>
            <span class="hero-card-pill">Flutter · React Native</span>
          </div>
          <div class="hero-card">
            <div class="hero-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M22 2L12 12M15 2h7v7"/></svg>
            </div>
            <div class="hero-card-title">AI Integration</div>
            <div class="hero-card-sub">Smarter workflows · Intelligent systems</div>
            <span class="hero-card-pill">Powered by AI</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-line" aria-hidden="true"></div>
</section>

<!-- ══════════════════ TRUSTED BY ══════════════════════ -->
<div id="trusted">
  <div class="container">
    <div class="trusted-inner">
      <span class="trusted-label">Trusted by</span>
      <div class="trusted-logos">
        <span class="trusted-logo-item">DPD Gerindra Prov. Lampung</span>
        <span class="trusted-logo-item">PT Tunas Dwipa Matra</span>
        <span class="trusted-logo-item">PT Way Kanan Makmur</span>
        <span class="trusted-logo-item">Universitas Lampung</span>
        <span class="trusted-logo-item">RSUD Dr. H. Bob Bazar</span>
        <span class="trusted-logo-item">3I RTSP Construction</span>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════ SERVICES ════════════════════════ -->
<section id="services">
  <div class="container">
    <div class="services-header">
      <div>
        <div class="section-label">What We Do</div>
        <h2 class="section-title">Our Services</h2>
      </div>
      <p class="section-desc">Custom-built digital solutions — from web and mobile to AI-powered systems — designed around how your business actually works.</p>
    </div>
    <div class="section-sublabel">Core Services</div>
    <div class="services-grid core-services">
      {coreServices.map(({ icon, title, desc, tags, featured }) => (
        <div class={`service-card${featured ? ' service-card--featured' : ''}`}>
          <div class="service-icon" set:html={icon} aria-hidden="true"></div>
          <h3 class="service-title">{title}</h3>
          <p class="service-desc">{desc}</p>
          <div class="service-tags">
            {tags.map(t => <span class="service-tag">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
    <div class="section-sublabel" style="margin-top: 48px;">Extended Services</div>
    <div class="services-grid extended-services">
      {extendedServices.map(({ icon, title, desc, tags }) => (
        <div class="service-card service-card--extended">
          <div class="service-icon" set:html={icon} aria-hidden="true"></div>
          <h3 class="service-title">{title}</h3>
          <p class="service-desc">{desc}</p>
          <div class="service-tags">
            {tags.map(t => <span class="service-tag">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ ABOUT ════════════════════════════ -->
<section id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-content">
        <div class="section-label">About Gradien</div>
        <h2 class="section-title light">Built to Move<br/>Your Business Forward</h2>
        <p class="section-desc light">
          Founded in 2020, CV. Gradien Digital Indonesia — short for <em>Gerakan Digital Ekosistem Nusantara</em> — is a software house committed to building the digital ecosystem of Indonesia. We work with government agencies, enterprises, and growing businesses to build systems that solve real problems.
        </p>
        <p class="section-desc light" style="margin-top: 16px;">
          We use AI throughout our development process — not as a product to sell, but as how we work — to deliver solutions that are smarter, more efficient, and built to grow with your business.
        </p>
        <a href="#contact" class="btn btn-primary" style="margin-top: 32px;">Work With Us</a>
      </div>
      <div class="about-values">
        <div class="section-label">Our Core Values</div>
        <div class="values-grid">
          {[
            { icon: '🌱', title: 'Impact', desc: 'We provide value that transfers real benefits to your business and contributes to Indonesia\'s digital ecosystem.' },
            { icon: '🏆', title: 'Excellence', desc: 'We put forward competence and quality — encouraging the team to improve continuously for every project.' },
            { icon: '⚡', title: 'Challenged', desc: 'We believe in the passion of each individual and the drive to keep growing and contributing.' },
            { icon: '🤝', title: 'Positivity', desc: 'Cooperation and mutual trust — we build a culture that encourages both our team and our clients.' },
          ].map(({ icon, title, desc }) => (
            <div class="value-card">
              <span class="value-icon" aria-hidden="true">{icon}</span>
              <h4 class="value-title">{title}</h4>
              <p class="value-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════ PORTFOLIO ════════════════════════ -->
<section id="portfolio">
  <div class="container">
    <div class="portfolio-header">
      <div>
        <div class="section-label">Our Work</div>
        <h2 class="section-title">Real Projects, Real Impact</h2>
      </div>
      <p class="section-desc">A selection of projects we've delivered across industries and technology stacks.</p>
    </div>
    <div class="portfolio-grid">
      {portfolioItems.map(({ title, category, desc, tags, color }) => (
        <div class="portfolio-card" style={`--card-accent: ${color}`}>
          <div class="portfolio-card-bar" aria-hidden="true"></div>
          <div class="portfolio-card-cat">{category}</div>
          <h3 class="portfolio-card-title">{title}</h3>
          <p class="portfolio-card-desc">{desc}</p>
          <div class="portfolio-card-tags">
            {tags.map(t => <span class="portfolio-tag">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ PROCESS ══════════════════════════ -->
<section id="process">
  <div class="container">
    <div class="process-header">
      <div class="section-label">How We Work</div>
      <h2 class="section-title">From Idea to Launch —<br/>Our 4-Step Process</h2>
    </div>
    <div class="process-steps">
      {processSteps.map(({ number, title, desc }) => (
        <div class="process-step">
          <div class="process-number" aria-hidden="true">{number}</div>
          <h3 class="process-title">{title}</h3>
          <p class="process-desc">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ TECH STACK ════════════════════════ -->
<section id="tech">
  <div class="container">
    <div class="section-label">Technology</div>
    <h2 class="section-title">Our Tech Stack</h2>
    <p class="section-desc">We choose the right tools for the job — proven technologies that deliver performant, maintainable solutions.</p>
  </div>
  <div class="tech-marquee-wrapper">
    <!-- Row 1: scroll left -->
    <div class="tech-marquee-track">
      <div class="tech-marquee-row tech-marquee-left">
        {[...techStack.slice(0, 19), ...techStack.slice(0, 19)].map(({ name, logo }) => (
          <div class="tech-logo-item">
            <img src={logo} alt={name} class="tech-logo-img" loading="lazy" />
            <span class="tech-logo-label">{name}</span>
          </div>
        ))}
      </div>
    </div>
    <!-- Row 2: scroll right -->
