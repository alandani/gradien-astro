---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogCard from '../components/BlogCard.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://gradien.co/#organization",
      "name": "Gradien Digital Indonesia",
      "alternateName": "Gradien Digital",
      "url": "https://gradien.co",
      "logo": { "@type": "ImageObject", "url": "https://gradien.co/logo.png", "width": 200, "height": 200 },
      "description": "Gradien Digital Indonesia — your partner for smarter digital solutions. We build custom websites, mobile apps, and enterprise systems with AI embedded in our process.",
      "foundingDate": "2020",
      "email": "business@gradien.co",
      "telephone": "+6285157012200",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Anggrek No. 37, Rawa Laut, Enggal",
        "addressLocality": "Bandar Lampung",
        "addressRegion": "Lampung",
        "addressCountry": "ID"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": -5.4500, "longitude": 105.2667 },
      "sameAs": ["https://business.gradien.co"],
      "knowsAbout": ["Mobile Application Development","Web Development","ERP Implementation","Odoo","AI Integration","Geographic Information System","Data Analytics","UI/UX Design","IT Consulting"]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://gradien.co/#localbusiness",
      "name": "CV. Gradien Digital Indonesia",
      "image": "https://gradien.co/og-image.jpg",
      "url": "https://gradien.co",
      "telephone": "+6285157012200",
      "email": "business@gradien.co",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Anggrek No. 37, Rawa Laut, Enggal",
        "addressLocality": "Bandar Lampung",
        "addressRegion": "Lampung",
        "addressCountry": "ID"
      },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "09:00", "closes": "17:00"
