---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogCard from '../components/BlogCard.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://gradien.co/#organization",
      "name": "CV. Gradien Digital Indonesia",
      "alternateName": "Gradien Digital",
      "url": "https://gradien.co",
      "logo": { "@type": "ImageObject", "url": "https://gradien.co/logo.png", "width": 200, "height": 200 },
      "description": "Software house based in Bandar Lampung, Indonesia. Specialists in mobile app, web development, ERP Odoo, AI integration, GIS, and data analytics.",
      "foundingDate": "2020",
      "email": "business@gradien.co",
      "telephone": "+6285157012200",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Anggrek No. 37, Rawa Laut, Enggal",
        "addressLocality": "Bandar Lampung",
        "addressRegion": "Lampung",
        "addressCountry": "ID"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": -5.4500, "longitude": 105.2667 },
      "sameAs": ["https://business.gradien.co"],
      "knowsAbout": ["Mobile Application Development","Web Development","ERP Implementation","Odoo","AI Integration","Geographic Information System","Data Analytics","UI/UX Design","IT Consulting"]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://gradien.co/#localbusiness",
      "name": "CV. Gradien Digital Indonesia",
      "image": "https://gradien.co/og-image.jpg",
      "url": "https://gradien.co",
      "telephone": "+6285157012200",
      "email": "business@gradien.co",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Anggrek No. 37, Rawa Laut, Enggal",
        "addressLocality": "Bandar Lampung",
        "addressRegion": "Lampung",
        "addressCountry": "ID"
      },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "09:00", "closes": "17:00"
      }]
    },
    {
      "@type": "WebSite",
      "@id": "https://gradien.co/#website",
      "url": "https://gradien.co",
      "name": "Gradien Digital Indonesia",
      "description": "Software house Bandar Lampung — mobile app, web, ERP, AI, GIS",
      "publisher": { "@id": "https://gradien.co/#organization" }
    }
  ]
};

const services = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title: 'Mobile App Development',
    desc: 'Native and cross-platform apps for iOS & Android. From fintech to logistics, we build apps users love.',
    tags: ['Flutter', 'React Native', 'iOS', 'Android'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    title: 'Web Development',
    desc: 'Scalable web applications with modern frameworks. From landing pages to enterprise portals.',
    tags: ['React', 'Next.js', 'Astro', 'Laravel'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z M9 9h6M9 12h6M9 15h4"/></svg>`,
    title: 'ERP Odoo',
    desc: 'Full-cycle Odoo implementation, customization, and training. Streamline your business operations.',
    tags: ['Odoo 17', 'Accounting', 'Inventory', 'CRM'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M22 2L12 12M15 2h7v7"/></svg>`,
    title: 'AI Integration',
    desc: 'Embed intelligent automation into your products. LLMs, computer vision, NLP, and custom ML models.',
    tags: ['OpenAI', 'LangChain', 'Python', 'TensorFlow'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v9h9"/></svg>`,
    title: 'GIS Solutions',
    desc: 'Geographic information systems for mapping, spatial analysis, and location intelligence.',
    tags: ['QGIS', 'MapboxGL', 'PostGIS', 'Leaflet'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    title: 'Data Analytics',
    desc: 'Turn raw data into actionable insights. Dashboards, reports, and predictive analytics.',
    tags: ['Python', 'Tableau', 'Power BI', 'BigQuery'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`,
    title: 'UI/UX Design',
    desc: 'User-centered design that converts. Wireframes, prototypes, and design systems.',
    tags: ['Figma', 'User Research', 'Prototyping'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'IT Consulting',
    desc: 'Strategic technology guidance. Architecture review, digital transformation roadmap, and training.',
    tags: ['Strategy', 'Architecture', 'Training'],
  },
];

const portfolioItems = [
  {
    title: 'Land Registry GIS System',
    category: 'GIS · Government',
    desc: 'A spatial data platform for local government enabling real-time land parcel tracking across 40,000+ records.',
    tags: ['QGIS', 'PostGIS', 'React', 'FastAPI'],
    color: '#0D7A95',
  },
  {
    title: 'ERP Odoo for Retail Chain',
    category: 'ERP · Retail',
    desc: 'End-to-end Odoo 17 implementation covering inventory, POS, accounting, and HR for a 12-outlet chain.',
    tags: ['Odoo 17', 'PostgreSQL', 'Python'],
    color: '#1AABCC',
  },
  {
    title: 'Logistics Mobile App',
    category: 'Mobile · Logistics',
    desc: 'Flutter-based driver app with real-time GPS tracking, digital POD, and offline-first architecture.',
    tags: ['Flutter', 'Firebase', 'Google Maps'],
    color: '#074558',
  },
  {
    title: 'AI-Powered Document OCR',
    category: 'AI · Finance',
    desc: 'Intelligent document processing system for a financial institution — 95% extraction accuracy on mixed document types.',
    tags: ['Python', 'OpenAI', 'Tesseract', 'FastAPI'],
    color: '#0D7A95',
  },
  {
    title: 'Hospital Management System',
    category: 'Web · Healthcare',
    desc: 'Integrated HMS with patient records, appointment scheduling, billing, and pharmacy modules.',
    tags: ['Laravel', 'Vue.js', 'MySQL'],
    color: '#1AABCC',
  },
  {
    title: 'Supply Chain Analytics Dashboard',
    category: 'Analytics · Manufacturing',
    desc: 'Real-time BI dashboard connecting ERP, IoT sensors, and warehouse data for production insights.',
    tags: ['Python', 'Power BI', 'REST API'],
    color: '#074558',
  },
];

const techStack = {
  'Mobile': ['Flutter', 'React Native', 'Swift', 'Kotlin'],
  'Frontend': ['React', 'Next.js', 'Astro', 'Vue.js', 'TypeScript'],
  'Backend': ['Laravel', 'FastAPI', 'Node.js', 'Django', 'Go'],
  'Data & AI': ['Python', 'TensorFlow', 'LangChain', 'Power BI', 'BigQuery'],
  'GIS': ['QGIS', 'PostGIS', 'Mapbox GL', 'Leaflet', 'GeoServer'],
  'ERP': ['Odoo 17', 'PostgreSQL', 'Python ORM'],
  'DevOps': ['Docker', 'GitHub Actions', 'AWS', 'Nginx', 'Linux'],
};

const testimonials = [
  {
    quote: "Gradien delivered our GIS system on time and within budget. Their attention to spatial data accuracy and clean UI was exceptional.",
    name: "Ir. Budi Santoso",
    role: "Head of IT, Lampung Provincial Government",
    initials: "BS",
  },
  {
    quote: "The Odoo implementation was smooth and the team's support during go-live was outstanding. Our inventory errors dropped by 80%.",
    name: "Ratna Dewi",
    role: "Operations Director, PT Maju Bersama",
    initials: "RD",
  },
  {
    quote: "Our Flutter app went from zero to App Store in 14 weeks. Gradien managed scope, quality, and deadlines better than any team I've worked with.",
    name: "Ahmad Fauzan",
    role: "CEO, LogiTrack Indonesia",
    initials: "AF",
  },
];

const processSteps = [
  { number: '01', title: 'Discovery', desc: 'We deep-dive into your goals, users, and constraints. Requirements are documented and scope is locked.' },
  { number: '02', title: 'Design', desc: 'Wireframes, prototypes, and architecture blueprints. You approve before we write a single line of code.' },
  { number: '03', title: 'Build', desc: 'Agile sprints with weekly demos. Full transparency — you see the product grow in real time.' },
  { number: '04', title: 'Launch', desc: 'Rigorous testing, deployment, and handover. Post-launch support included for 30 days.' },
];
---

<BaseLayout
  title="Gradien Digital Indonesia — Software House Bandar Lampung"
  description="CV. Gradien Digital Indonesia adalah software house di Bandar Lampung. Kami membangun mobile app, website, ERP Odoo, AI integration, GIS, dan solusi digital lainnya untuk bisnis Indonesia dan global."
  tags={["software house Bandar Lampung","jasa pembuatan aplikasi Lampung","web development Lampung","ERP Odoo Lampung","AI integration Indonesia","mobile app development","GIS Indonesia","Gradien Digital"]}
  jsonLd={homeJsonLd}
>

<!-- ══════════════════ HERO ══════════════════════════ -->
<section id="hero">
  <div class="hero-dots" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="hero-badge-dot" aria-hidden="true"></span>
          <span>Based in Bandar Lampung, Indonesia</span>
        </div>
        <h1 class="hero-title">
          We Build<br/>
          <span class="accent">Digital Products</span><br/>
          That Matter
        </h1>
        <p class="hero-sub">
          From mobile apps to ERP systems, AI integration to GIS platforms — Gradien delivers end-to-end digital solutions for organizations across Indonesia.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">Start a Project</a>
          <a href="#portfolio" class="btn btn-outline">See Our Work</a>
        </div>
        <div class="hero-stats">
          <div>
            <div class="stat-num">50<span class="stat-accent">+</span></div>
            <div class="stat-label">Projects Delivered</div>
          </div>
          <div>
            <div class="stat-num">30<span class="stat-accent">+</span></div>
            <div class="stat-label">Happy Clients</div>
          </div>
          <div>
            <div class="stat-num">5<span class="stat-accent">+</span></div>
            <div class="stat-label">Years Experience</div>
          </div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hero-blob"></div>
        <div class="hero-card-stack">
          <div class="hero-card">
            <div class="hero-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </div>
            <div class="hero-card-title">Mobile App Development</div>
            <div class="hero-card-sub">Flutter · React Native · iOS · Android</div>
            <span class="hero-card-pill">Flutter 3.22</span>
          </div>
          <div class="hero-card">
            <div class="hero-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M22 2L12 12M15 2h7v7"/></svg>
            </div>
            <div class="hero-card-title">AI Integration</div>
            <div class="hero-card-sub">LLMs · Computer Vision · NLP</div>
            <span class="hero-card-pill">GPT-4o · LangChain</span>
          </div>
          <div class="hero-card">
            <div class="hero-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v9h9"/></svg>
            </div>
            <div class="hero-card-title">GIS Solutions</div>
            <div class="hero-card-sub">Spatial data · Mapping · Analytics</div>
            <span class="hero-card-pill">PostGIS · Mapbox</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-line" aria-hidden="true"></div>
</section>

<!-- ══════════════════ TRUSTED BY ══════════════════════ -->
<div id="trusted">
  <div class="container">
    <div class="trusted-inner">
      <span class="trusted-label">Trusted by</span>
      <div class="trusted-logos">
        <span class="trusted-logo-item">Pemprov Lampung</span>
        <span class="trusted-logo-item">PT Maju Bersama</span>
        <span class="trusted-logo-item">LogiTrack</span>
        <span class="trusted-logo-item">RS Urip Sumoharjo</span>
        <span class="trusted-logo-item">Universitas Lampung</span>
        <span class="trusted-logo-item">Bank Lampung</span>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════ SERVICES ════════════════════════ -->
<section id="services">
  <div class="container">
    <div class="services-header">
      <div>
        <div class="section-label">What We Do</div>
        <h2 class="section-title">End-to-End Digital Services</h2>
      </div>
      <p class="section-desc">From concept to deployment, we cover every layer of your digital product — design, development, data, and intelligence.</p>
    </div>
    <div class="services-grid">
      {services.map(({ icon, title, desc, tags }) => (
        <div class="service-card">
          <div class="service-icon" set:html={icon} aria-hidden="true"></div>
          <h3 class="service-title">{title}</h3>
          <p class="service-desc">{desc}</p>
          <div class="service-tags">
            {tags.map(t => <span class="service-tag">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ ABOUT ════════════════════════════ -->
<section id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-content">
        <div class="section-label">About Gradien</div>
        <h2 class="section-title light">Built by Engineers,<br/>Driven by Impact</h2>
        <p class="section-desc light">
          Founded in 2020, CV. Gradien Digital Indonesia is a software house headquartered in Bandar Lampung. We work with government agencies, startups, and enterprises to build digital systems that solve real problems.
        </p>
        <p class="section-desc light" style="margin-top: 16px;">
          Our team combines deep technical expertise with strong product thinking — so the software we ship doesn't just work, it works for your users.
        </p>
        <a href="#contact" class="btn btn-primary" style="margin-top: 32px;">Work With Us</a>
      </div>
      <div class="about-values">
        <div class="section-label">Our Core Values</div>
        <div class="values-grid">
          {[
            { icon: '🎯', title: 'Precision', desc: 'We obsess over the details — in code, in design, in communication.' },
            { icon: '🤝', title: 'Partnership', desc: 'We treat every project as if it were our own business on the line.' },
            { icon: '⚡', title: 'Speed', desc: 'Move fast without breaking things. Rapid iteration, solid foundations.' },
            { icon: '🔒', title: 'Integrity', desc: 'Transparent pricing, honest timelines, no hidden surprises.' },
          ].map(({ icon, title, desc }) => (
            <div class="value-card">
              <span class="value-icon" aria-hidden="true">{icon}</span>
              <h4 class="value-title">{title}</h4>
              <p class="value-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════ PORTFOLIO ════════════════════════ -->
<section id="portfolio">
  <div class="container">
    <div class="portfolio-header">
      <div>
        <div class="section-label">Our Work</div>
        <h2 class="section-title">Real Projects, Real Impact</h2>
      </div>
      <p class="section-desc">A selection of projects we've delivered across industries and technology stacks.</p>
    </div>
    <div class="portfolio-grid">
      {portfolioItems.map(({ title, category, desc, tags, color }) => (
        <div class="portfolio-card" style={`--card-accent: ${color}`}>
          <div class="portfolio-card-bar" aria-hidden="true"></div>
          <div class="portfolio-card-cat">{category}</div>
          <h3 class="portfolio-card-title">{title}</h3>
          <p class="portfolio-card-desc">{desc}</p>
          <div class="portfolio-card-tags">
            {tags.map(t => <span class="portfolio-tag">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ PROCESS ══════════════════════════ -->
<section id="process">
  <div class="container">
    <div class="process-header">
      <div class="section-label">How We Work</div>
      <h2 class="section-title">From Idea to Launch —<br/>Our 4-Step Process</h2>
    </div>
    <div class="process-steps">
      {processSteps.map(({ number, title, desc }) => (
        <div class="process-step">
          <div class="process-number" aria-hidden="true">{number}</div>
          <h3 class="process-title">{title}</h3>
          <p class="process-desc">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ TECH STACK ════════════════════════ -->
<section id="tech">
  <div class="container">
    <div class="section-label">Technology</div>
    <h2 class="section-title">Our Tech Stack</h2>
    <p class="section-desc">We choose the right tools for the job — proven technologies that deliver performant, maintainable solutions.</p>
    <div class="tech-grid">
      {Object.entries(techStack).map(([category, items]) => (
        <div class="tech-group">
          <div class="tech-group-label">{category}</div>
          <div class="tech-tags">
            {items.map(item => <span class="tech-tag">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ TESTIMONIALS ════════════════════ -->
<section id="testimonials">
  <div class="container">
    <div class="section-label">What Clients Say</div>
    <h2 class="section-title light">Trusted by Organizations<br/>Across Indonesia</h2>
    <div class="testimonials-grid">
      {testimonials.map(({ quote, name, role, initials }) => (
        <div class="testimonial-card">
          <blockquote class="testimonial-quote">"{quote}"</blockquote>
          <div class="testimonial-author">
            <div class="testimonial-avatar" aria-hidden="true">{initials}</div>
            <div>
              <div class="testimonial-name">{name}</div>
              <div class="testimonial-role">{role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ BLOG PREVIEW ══════════════════════ -->
{recentPosts.length > 0 && (
  <section id="blog-preview">
    <div class="container">
      <div class="blog-preview-header">
        <div>
          <div class="section-label">Insights</div>
          <h2 class="section-title">From the Blog</h2>
        </div>
        <a href="/blog" class="btn btn-dark">All Articles →</a>
      </div>
      <div class="blog-preview-grid">
        {recentPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            heroImage={post.data.heroImage}
            heroImageAlt={post.data.heroImageAlt}
            tags={post.data.tags}
            slug={post.slug}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    </div>
  </section>
)}

<!-- ══════════════════ CONTACT ════════════════════════════ -->
<section id="contact">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-left">
        <div class="section-label">Get In Touch</div>
        <h2 class="section-title">Let's Build<br/>Something Great</h2>
        <p class="section-desc" style="margin-bottom: 40px;">
          Ready to start your next digital project? Tell us about your idea and we'll get back to you within one business day.
        </p>
        <div class="contact-info">
          <div class="contact-info-item">
            <div class="contact-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <div class="contact-info-label">Email</div>
              <a href="mailto:business@gradien.co" class="contact-info-value">business@gradien.co</a>
            </div>
          </div>
          <div class="contact-info-item">
            <div class="contact-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.61 5a2 2 0 0 1 1.99-2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <div class="contact-info-label">WhatsApp</div>
              <a href="https://wa.me/6285157012200" target="_blank" rel="noopener noreferrer" class="contact-info-value">+62 851 5701 2200</a>
            </div>
          </div>
          <div class="contact-info-item">
            <div class="contact-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <div class="contact-info-label">Office</div>
              <span class="contact-info-value">Jl. Anggrek No. 37, Bandar Lampung</span>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-right">
        <form class="contact-form" name="contact" method="POST" action="/thank-you">
          <div class="form-row">
            <div class="form-group">
              <label for="name" class="form-label">Full Name</label>
              <input type="text" id="name" name="name" placeholder="Your name" required class="form-input" />
            </div>
            <div class="form-group">
